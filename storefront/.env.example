# Supabase project (Project Settings > API). Use the anon/publishable key only - never the service_role key.
VITE_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
VITE_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"

# Email notifications (set in Vercel; server-side only, no VITE_ prefix). See README "Email notifications".
RESEND_API_KEY="re_YOUR_RESEND_API_KEY"
OWNER_EMAIL="owner@example.com"
FROM_EMAIL="Attrangii <orders@yourdomain.com>"
SITE_URL="https://attrangii-store.vercel.app"
